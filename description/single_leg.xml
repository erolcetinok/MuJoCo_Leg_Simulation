<mujoco model="single_leg">
    <compiler angle="radian"/>

    <!-- Kinematics rig: gravity off so the leg holds its commanded pose and
         only moves when actuator sliders are dragged in the viewer panel. -->
    <option gravity="0 0 0"/>

    <!-- See quadruped.xml: <map> values are fractions of model extent, so pin
         extent to the leg rather than let the ground plane set it. -->
    <statistic extent="400" center="0 0 200"/>

    <visual>
        <quality shadowsize="8192" offsamples="8"/>
        <map znear="0.01" zfar="200" fogstart="5" fogend="20"/>
        <rgba haze="0.82 0.87 0.94 1"/>
        <global azimuth="140" elevation="-22" offwidth="1920" offheight="1080"/>
    </visual>

    <default>
        <joint damping="2"/>
    </default>

    <asset>
        <mesh name="shoulder_mesh" file="meshes/shoulder.STL"/>
        <mesh name="thigh_mesh"    file="meshes/thigh.STL"/>
        <mesh name="foot_mesh"     file="meshes/foot.STL"/>

        <!-- Matches quadruped.xml so the two rigs look like the same robot. -->
        <texture name="texgrid" type="2d" builtin="checker"
                 rgb1="0.62 0.66 0.72" rgb2="0.80 0.83 0.87"
                 mark="edge" markrgb="0.45 0.49 0.55"
                 width="512" height="512"/>
        <material name="grid" texture="texgrid" texrepeat="10 10"
                  specular="0.1" shininess="0.1" reflectance="0.12"/>
        <texture name="sky" type="skybox" builtin="gradient"
                 rgb1="0.55 0.68 0.86" rgb2="0.86 0.90 0.95"
                 width="1024" height="1024"/>
        <material name="leg_mat" rgba="0.58 0.61 0.66 1"
                  specular="0.6" shininess="0.6" reflectance="0.15"/>
    </asset>

    <worldbody>
        <geom name="ground" type="plane" size="1000 1000 0.1" material="grid" rgba="1 1 1 1"/>

        <!-- World origin triad: X red, Y green, Z blue. Lengths are in mm like
             everything else — the old 3-unit version was left over from a
             metre-scale model and was invisible next to a 200 mm leg. Arrows are
             a thin shaft plus a fatter head because MuJoCo has no cone/arrow
             site type. The horizontal pair sits 1 mm up so it doesn't z-fight
             with the ground plane. Toggle them off with the viewer's site flag. -->
        <site name="world_x"      type="capsule"  fromto="0 0 1  100 0 1"   size="2.5" rgba="1 0 0 1"/>
        <site name="world_x_head" type="cylinder" fromto="100 0 1  122 0 1" size="6"   rgba="1 0 0 1"/>
        <site name="world_y"      type="capsule"  fromto="0 0 1  0 100 1"   size="2.5" rgba="0 1 0 1"/>
        <site name="world_y_head" type="cylinder" fromto="0 100 1  0 122 1" size="6"   rgba="0 1 0 1"/>
        <site name="world_z"      type="capsule"  fromto="0 0 0  0 0 100"   size="2.5" rgba="0 0 1 1"/>
        <site name="world_z_head" type="cylinder" fromto="0 0 100  0 0 122" size="6"   rgba="0 0 1 1"/>

        <!-- Shoulder fixed to the world. Body pos chosen so the shoulder hinge
             axis sits at world (0, 0, 300) — that point is the FK hip-frame
             origin, so MuJoCo foot_site == fk() + (0, 0, 300). -->
        <body name="shoulder" pos="-20.25 15 300">
            <joint name="shoulder_joint" type="hinge" axis="0 0 1" pos="20.25 -15 0"
                   limited="true" range="-1.57079632679 1.57079632679"/>
            <geom type="mesh"
                  mesh="shoulder_mesh"
                  quat="0.7071068 0.7071068 0 0" material="leg_mat"/>

            <body name="thigh" pos="0 -35.75 -13.1">
                <joint name="wing_joint" type="hinge" axis="1 0 0" pos="0 -2.5 34.5"
                       limited="true" range="-0.872664625997 0.872664625997"/>
                <geom type="mesh"
                      mesh="thigh_mesh"
                      quat="0.7071068 0.7071068 0 0" material="leg_mat"/>

                <body name="foot" pos="0 -98 -98.75">
                    <joint name="knee_joint" type="hinge" axis="1 0 0" pos="0 -12 110"
                           limited="true" range="-2.00712863979 1.57079632679"/>
                    <geom type="mesh"
                          mesh="foot_mesh"
                          quat="0.7071068 0.7071068 0 0" material="leg_mat"/>

                    <site name="foot_site" pos="21 -12 0" size="5" rgba="1 0 0 1"/>
                </body>
            </body>
        </body>

        <body name="ik_target" mocap="true" pos="-19.25 44.25 238.15">
            <site name="target_site" pos="20 -175 -50" size="8" rgba="1 0.5 0 1"/>
        </body>
    </worldbody>

    <actuator>
        <position name="shoulder_actuator" joint="shoulder_joint" kp="80"
                  ctrlrange="-1.57079632679 1.57079632679"/>
        <position name="wing_actuator" joint="wing_joint" kp="60"
                  ctrlrange="-0.872664625997 0.872664625997"/>
        <position name="knee_actuator" joint="knee_joint" kp="80"
                  ctrlrange="-2.00712863979 1.57079632679"/>
    </actuator>
</mujoco>
