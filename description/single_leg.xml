<mujoco model="single_leg">
    <compiler angle="radian"/>

    <!-- Kinematics rig: gravity off so the leg holds its commanded pose and
         only moves when actuator sliders are dragged in the viewer panel. -->
    <option gravity="0 0 0"/>

    <default>
        <joint damping="2"/>
    </default>

    <asset>
        <mesh name="shoulder_mesh" file="meshes/shoulder.STL"/>
        <mesh name="thigh_mesh"    file="meshes/thigh.STL"/>
        <mesh name="foot_mesh"     file="meshes/foot.STL"/>

        <texture name="texgrid" type="2d" builtin="checker"
                 rgb1="0.2 0.2 0.2" rgb2="0.85 0.85 0.85"
                 width="512" height="512"/>
        <material name="grid" texture="texgrid" texrepeat="10 10" reflectance="0.2"/>
    </asset>

    <worldbody>
        <geom name="ground" type="plane" size="1000 1000 0.1" material="grid" rgba="1 1 1 1"/>

        <site name="world_x" type="capsule" fromto="0 0 0  3 0 0" size="0.05" rgba="1 0 0 1"/>
        <site name="world_y" type="capsule" fromto="0 0 0  0 3 0" size="0.05" rgba="0 1 0 1"/>
        <site name="world_z" type="capsule" fromto="0 0 0  0 0 3" size="0.05" rgba="0 0 1 1"/>

        <!-- Shoulder fixed to the world. Body pos chosen so the shoulder hinge
             axis sits at world (0, 0, 300) — that point is the FK hip-frame
             origin, so MuJoCo foot_site == fk() + (0, 0, 300). -->
        <body name="shoulder" pos="-20.25 15 300">
            <joint name="shoulder_joint" type="hinge" axis="0 0 1" pos="20.25 -15 0"
                   limited="true" range="-1.57079632679 1.57079632679"/>
            <geom type="mesh"
                  mesh="shoulder_mesh"
                  quat="0.7071068 0.7071068 0 0"/>

            <body name="thigh" pos="0 -35.75 -13.1">
                <joint name="wing_joint" type="hinge" axis="1 0 0" pos="0 -2.5 34.5"
                       limited="true" range="-0.872664625997 0.872664625997"/>
                <geom type="mesh"
                      mesh="thigh_mesh"
                      quat="0.7071068 0.7071068 0 0"/>

                <body name="foot" pos="0 -98 -98.75">
                    <joint name="knee_joint" type="hinge" axis="1 0 0" pos="0 -12 110"
                           limited="true" range="-2.00712863979 1.57079632679"/>
                    <geom type="mesh"
                          mesh="foot_mesh"
                          quat="0.7071068 0.7071068 0 0"/>

                    <site name="foot_site" pos="21 -12 0" size="1" rgba="1 0 0 1"/>
                </body>
            </body>
        </body>

        <body name="ik_target" mocap="true" pos="-19.25 44.25 238.15">
            <site name="target_site" pos="20 -175 -50" size="8" rgba="1 0.5 0 1"/>
        </body>
    </worldbody>

    <actuator>
        <position name="shoulder_actuator" joint="shoulder_joint" kp="80"
                  ctrlrange="-1.57079632679 1.57079632679"/>
        <position name="wing_actuator" joint="wing_joint" kp="60"
                  ctrlrange="-0.872664625997 0.872664625997"/>
        <position name="knee_actuator" joint="knee_joint" kp="80"
                  ctrlrange="-2.00712863979 1.57079632679"/>
    </actuator>
</mujoco>
